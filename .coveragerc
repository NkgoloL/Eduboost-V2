[run]
branch = True
concurrency = greenlet,thread
dynamic_context = test_function
source = app

[paths]
source =
    app
    /tmp/eduboost-unit-leaf-*/repo/app
    /tmp/eduboost-terminal-leaf-*/repo/app

[report]
precision = 1
skip_covered = False
show_missing = True

[html]
directory = coverage_html
