{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LEV Evidence Manifest",
  "type": "object",
  "required": [
    "manifest_id",
    "task_ids",
    "created_at",
    "files",
    "approvals"
  ],
  "properties": {
    "manifest_id": {
      "type": "string"
    },
    "task_ids": {
      "type": "array"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ]
      }
    },
    "approvals": {
      "type": "array"
    }
  }
}